# Paddle environment — required. Must be "live" or "sandbox". Never omit / never silently default.
NEXT_PUBLIC_PADDLE_ENV=live

# Client-side token (safe in browser). live_… for live, test_… for sandbox.
# Create/rotate in Paddle dashboard or via paddle-live MCP clientTokens.create.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Price IDs for the three tiers (must match NEXT_PUBLIC_PADDLE_ENV account)
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_ADVANCED_YEAR=

# Server-only — never expose to the client / 'use client' modules
PADDLE_API_KEY=
# Notification destination endpoint_secret_key (NOT the API key).
# Live destination: ntfset_01kyg56dzx6wx7ryw256n1pkyb →
#   https://wrdaxsuifqrvlkhcqzpk.supabase.co/functions/v1/paddle-webhook
# Do not delete that destination — it is permanent fulfillment infrastructure.
PADDLE_WEBHOOK_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy JWT anon key (fallback)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Must match private.app_secrets.fulfillment_token in Supabase
SUPABASE_FULFILLMENT_TOKEN=

# Discord OAuth — configure in Supabase Dashboard (Auth → Providers → Discord),
# NOT as NEXT_PUBLIC vars. Create an app at https://discord.com/developers/applications
# Callback URL for Discord (unchanged — points at Supabase):
#   https://<project-ref>.supabase.co/auth/v1/callback
# Redirect URLs in Supabase Auth (must include the live site):
#   https://shadygames.xyz/auth/callback
#   https://www.shadygames.xyz/auth/callback
#   http://localhost:3000/auth/callback

# Public site URL (canonical production domain)
NEXT_PUBLIC_SITE_URL=https://shadygames.xyz

# Supabase Auth → URL Configuration (required for email confirm + Discord OAuth):
# Site URL:
#   https://shadygames.xyz
# Redirect URLs (add all):
#   https://shadygames.xyz/**
#   https://shadygames.xyz/auth/callback
#   https://www.shadygames.xyz/**
#   https://www.shadygames.xyz/auth/callback
#   https://main.d2yt3tea7h06ja.amplifyapp.com/**
#   https://main.d2yt3tea7h06ja.amplifyapp.com/auth/callback
#   http://localhost:3000/**
#   http://localhost:3000/auth/callback

# Paddle Checkout (dashboard-only — cannot be set via API):
# 1. Go to Paddle → Checkout → Checkout settings
# 2. Set Default payment link to your live approved page, e.g. https://shadygames.xyz/pricing
#    (must be a real approved domain on live — not localhost)
# 3. Approve shadygames.xyz (and www if used) as a checkout domain
# On sandbox, localhost is fine for testing.

# Optional override for the TikTok games catalog product (defaults to live pro_01kygdffxq0mbazaykmms94spm)
# PADDLE_GAMES_PRODUCT_ID=pro_01kygdffxq0mbazaykmms94spm
